FROM alpine:3.20

# Install required tools for k0s & container runtimes
RUN sed -i 's/https:/http:/g' /etc/apk/repositories \
    && apk add --no-cache \
    openrc \
    ca-certificates \
    e2fsprogs \
    findmnt \
    iproute2 \
    iptables \
    ip6tables \
    util-linux \
    tzdata \
    curl \
    bash \
    coreutils

# Configure OpenRC
RUN sed -i 's/#rc_sys=""/rc_sys="openvz"/' /etc/rc.conf \
    && echo 'rc_provide="loopback net"' >> /etc/rc.conf \
    && find / -name "openrc-run.sh" -exec sed -i 's/cgroup_add_service /# cgroup_add_service /g' {} +

# Copy Firecracker microVM kernel
COPY bin/vmlinux /boot/vmlinux

# Copy fckind guest init & vsock agent
COPY bin/fckind-guest-init /sbin/overlay-init
RUN ln -sf /sbin/overlay-init /usr/local/bin/fckind-agent

# Install and enable fckind-agent OpenRC service
COPY images/node/fckind-agent.openrc /etc/init.d/fckind-agent
RUN chmod +x /etc/init.d/fckind-agent \
    && rc-update add fckind-agent default

# Copy k0s binary
COPY bin/k0s /usr/local/bin/k0s
RUN chmod +x /usr/local/bin/k0s

# Create k0s directory structure
RUN mkdir -p /var/lib/k0s/images /etc/k0s /var/log

# Copy k0s airgap image bundle for offline bootstrap
COPY bin/bundle.tar /var/lib/k0s/images/bundle.tar

WORKDIR /root
CMD ["/sbin/init"]
