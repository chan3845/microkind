FROM debian:bookworm-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    bc \
    bison \
    flex \
    libssl-dev \
    libelf-dev \
    curl \
    ca-certificates \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

ARG KERNEL_VERSION=6.1.102
WORKDIR /build

RUN curl -fSL https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-${KERNEL_VERSION}.tar.xz | tar -xJ --strip-components=1

COPY kernel.config .config
RUN make olddefconfig
RUN make -j$(nproc) vmlinux

FROM scratch
COPY --from=builder /build/vmlinux /boot/vmlinux
